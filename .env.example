# AI Log Analyzer — environment variables
# Copy to .env and edit. Nothing here is required: the tool runs against the
# FRR docker logs out of the box.

# ── Server ────────────────────────────────────────────────────────────────────
ANALYZER_PORT=6060
# Bind address. Default 127.0.0.1 (localhost only). Set 0.0.0.0 to expose —
# the server warns if you do that without an API token.
#ANALYZER_HOST=127.0.0.1

# ── Security ──────────────────────────────────────────────────────────────────
# When set, every mutating/data API route requires the token, supplied as
# either `X-API-Token: <token>` or `Authorization: Bearer <token>`.
#AI_LOG_ANALYZER_API_TOKEN=
# CORS allow-list for /api/* (comma-separated origins).
#AI_LOG_ANALYZER_CORS_ORIGINS=http://localhost:6060,http://127.0.0.1:6060
# Colon-separated roots POST /api/analyze {source:"file"} may read from.
#AI_LOG_ANALYZER_FILE_ROOTS=~:/var/log

# ── LLM provider ──────────────────────────────────────────────────────────────
# ollama      : Ollama native API on :11434 (default provider)
# local       : Docker Model Runner (TCP 12434 or auto-detected Unix socket)
# claude      : Anthropic Claude first, fall back to local if Claude is unreachable
# claude-only : Anthropic Claude only — never call local
# grok        : xAI Grok first (sanitize-before-LLM), then local fallback
LLM_PROVIDER=ollama
LLM_ENABLED=true
LLM_TIMEOUT=120

# ── Shared state / durable ingest (multi-worker) ─────────────────────────────
# One SQLite WAL file for syslog spool, incident memory and LLM runtime toggles.
#AI_LOG_ANALYZER_STATE_DB=/var/lib/netlog-ai/state.db
# Optional separate syslog spool DB (defaults to the state DB).
#AI_LOG_ANALYZER_SYSLOG_SPOOL=
# Syslog sender allow-list (IPs / CIDRs) and socket receive buffer.
#AI_LOG_ANALYZER_SYSLOG_ALLOW=10.0.0.0/8,192.0.2.10
#AI_LOG_ANALYZER_SYSLOG_RCVBUF=4194304
# Dependency map for topology-aware suppression (see docs/OPERATIONS.md).
#AI_LOG_ANALYZER_DEPENDENCIES=/etc/netlog-ai/dependencies.json

# ── Retrieval index (RAG) ────────────────────────────────────────────────────
# BM25 index over configs, golden drift, NetBox, KB runbooks and incidents.
# Defaults to the shared state DB; build it with `ai-log-analyzer rag index`
# or POST /api/rag/reindex. AI_LOG_ANALYZER_RAG=0 turns evidence off.
#AI_LOG_ANALYZER_RAG_DB=/var/lib/netlog-ai/rag.db
#AI_LOG_ANALYZER_GOLDEN_DIR=/etc/netlog-ai/golden     # <site>/<host>.txt or <host>.txt

# ── Streaming triage worker ──────────────────────────────────────────────────
# Tails the syslog spool (needs AI_LOG_ANALYZER_STATE_DB). Sinks default to
# dry-run so nothing external happens until you opt in.
#AI_LOG_ANALYZER_TRIAGE_WORKER=true                   # start with the web app
#AI_LOG_ANALYZER_TRIAGE_SINKS=jira,servicenow,webhook # or dry-run
#AI_LOG_ANALYZER_TRIAGE_MIN_SEVERITY=high
#AI_LOG_ANALYZER_TRIAGE_WINDOW_S=300
#AI_LOG_ANALYZER_TRIAGE_COOLDOWN_S=900
#AI_LOG_ANALYZER_TRIAGE_MAX_TICKETS_PER_HOUR=30
#AI_LOG_ANALYZER_TRIAGE_SITE=dc1
#SERVICENOW_URL=https://example.service-now.com
#SERVICENOW_USER=
#SERVICENOW_PASSWORD=
#JIRA_URL=https://example.atlassian.net
#JIRA_EMAIL=
#JIRA_API_TOKEN=
#JIRA_PROJECT_KEY=NET

# ── RBAC + audit ─────────────────────────────────────────────────────────────
# Any of these turns auth on. Roles: viewer < operator < admin.
# AI_LOG_ANALYZER_API_TOKEN (above) is the legacy shared token = admin.
#AI_LOG_ANALYZER_VIEWER_TOKENS=noc-wall:<token>
#AI_LOG_ANALYZER_OPERATOR_TOKENS=alice:<token>,bob:<token>
#AI_LOG_ANALYZER_ADMIN_TOKENS=netops-lead:<token>
#AI_LOG_ANALYZER_RBAC_FILE=/etc/netlog-ai/rbac.json   # {"users":[{"name","role","token_sha256"}]}
#AI_LOG_ANALYZER_AUDIT_DB=/var/lib/netlog-ai/audit.db  # default: the state DB
#AI_LOG_ANALYZER_AUDIT_LLM=cloud                      # cloud | all | off

# ── LLM gateway policy ────────────────────────────────────────────────────────
# Local providers (ollama / local) NEVER fall back to a cloud API unless this
# is true. Also gates claude ↔ grok cross-cloud fallback.
#ALLOW_CLOUD_FALLBACK=false
# Hostname pseudonyms (<HOST_n>): auto = cloud providers only | always | never
#LLM_TOKENIZE_HOSTNAMES=auto
# Prompt budget in characters (~4 chars/token). Per provider or global.
#LLM_MAX_PROMPT_CHARS_OLLAMA=48000
#LLM_MAX_PROMPT_CHARS=
# Set to match the Ollama budget, otherwise Ollama truncates silently.
#OLLAMA_NUM_CTX=16384
# Retry on HTTP 429/5xx with exponential backoff (Retry-After honoured).
#LLM_MAX_RETRIES=2
#LLM_BACKOFF_BASE=1.0
#LLM_BACKOFF_MAX=20
# Bounds for the process-wide entity vault used by sanitize_vault.anonymize().
#AI_LOG_ANALYZER_VAULT_MAX_ENTRIES=4096
#AI_LOG_ANALYZER_VAULT_TTL_SECONDS=3600

# ── Ollama (native API) ───────────────────────────────────────────────────────
#OLLAMA_URL=http://localhost:11434
#OLLAMA_MODEL=qwen2.5-coder:latest

# ── Local LLM (Docker Model Runner) ───────────────────────────────────────────
MODEL_RUNNER_URL=http://localhost:12434
LLM_MODEL=ai/qwen3:latest

# ── Anthropic Claude ──────────────────────────────────────────────────────────
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── xAI Grok (optional) ───────────────────────────────────────────────────────
# Get a key at https://console.x.ai — the analyzer still sanitizes before the call.
#XAI_API_KEY=
#XAI_MODEL=grok-4
#XAI_URL=https://api.x.ai/v1

# ── Cross-run template memory (optional) ──────────────────────────────────────
# Path to a JSON store remembering every mined template shape across runs.
# When set, templates never seen in any prior run are flagged 🆕 in the
# Unknown Patterns panel and counted as new_template_count in /api/analyze.
# Stored templates are secret-sanitized and the file is forced to owner-only access.
#AI_LOG_ANALYZER_TEMPLATE_STORE=~/.cache/netlog-ai/templates.json

# ── Incident memory (optional) ────────────────────────────────────────────────
# JSONL journal of past analysis runs. When set, action items carry a
# "seen N× before" recurrence block and /api/incidents/similar?q= searches
# the history. Local-only, bounded, never leaves the host.
#AI_LOG_ANALYZER_INCIDENT_STORE=~/.cache/netlog-ai/incidents.jsonl

# ── Custom classification rules (optional) ────────────────────────────────────
# JSON file with a list of {"pattern", "severity", "category", "description"}
# objects. Loaded at startup; rules take precedence over the built-in KB.
# Add more at runtime via POST /api/rules.
#AI_LOG_ANALYZER_CUSTOM_RULES=~/.netlog-ai/rules.json

# ── Alert webhooks (optional) ────────────────────────────────────────────────
# When set, every analysis that finds events at/above the threshold severity
# fires a webhook. Delivery is best-effort (5s timeout, failures logged).
#AI_LOG_ANALYZER_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXX
#AI_LOG_ANALYZER_WEBHOOK_MIN_SEVERITY=high   # critical|high|medium|low
#AI_LOG_ANALYZER_WEBHOOK_FORMAT=slack        # slack|generic

# Max single-file size for POST /api/analyze {source:"file"} (MB). Streaming
# keeps memory flat at any size, but classification CPU must finish inside
# the HTTP worker timeout — use the CLI for bigger files (no timeout there).
#AI_LOG_ANALYZER_MAX_FILE_MB=200

# ── SolarWinds (optional) ─────────────────────────────────────────────────────
# Orion SWIS (typically TCP 17778) or Observability SaaS. Bearer token preferred;
# username+password is Basic auth. Never commit real credentials.
# Native env (SolarWindsConfig.from_env / SourceManager.load_from_env):
#SOLARWINDS_URL=https://orion.example.com:17778
#SOLARWINDS_USERNAME=
#SOLARWINDS_PASSWORD=
#SOLARWINDS_TOKEN=
#SOLARWINDS_MODE=swis
#SOLARWINDS_VERIFY_SSL=true
# Or a NETLOG_SOURCE_* block (extra.mode = swis|saas):
#NETLOG_SOURCE_orion_TYPE=solarwinds
#NETLOG_SOURCE_orion_URL=https://orion.example.com:17778
#NETLOG_SOURCE_orion_API_TOKEN=
#NETLOG_SOURCE_orion_USERNAME=
#NETLOG_SOURCE_orion_PASSWORD=

# ══════════════════════════════════════════════════════════════════════════════
# Additional settings. Full reference with defaults: docs/ENVIRONMENT.md
# Everything below is commented out; values are placeholders, never real secrets.
# ══════════════════════════════════════════════════════════════════════════════

# ── Server hardening ──────────────────────────────────────────────────────────
# Refuse to serve unless a token/RBAC principal is configured (recommended for
# any non-loopback deployment). ALLOW_NOAUTH is the explicit demo/lab opt-out.
#AI_LOG_ANALYZER_REQUIRE_AUTH=true
#AI_LOG_ANALYZER_ALLOW_NOAUTH=false
# Host-header allow-list (DNS-rebinding defense); add your public hostname behind a proxy.
#AI_LOG_ANALYZER_ALLOWED_HOSTS=localhost,127.0.0.1
# Cap on concurrent server-sent-event streams.
#AI_LOG_ANALYZER_MAX_SSE=16
# Single writable base directory for persisted state, and the key for stable pseudonyms.
#AI_LOG_ANALYZER_DATA_DIR=/var/lib/netlog-ai
#AI_LOG_ANALYZER_PSEUDONYM_KEY=<generate-with-a-password-manager>
# Allow plain http:// for outbound integrations. Leave false: it sends credentials in clear text.
#NETLOG_ALLOW_INSECURE_HTTP=false
# SQLite synchronous level for the state DB: OFF | NORMAL | FULL
#AI_LOG_ANALYZER_SQLITE_SYNC=NORMAL
# Print which .env files were loaded.
#AI_LOG_ANALYZER_DEBUG=1

# ── Demo data / site manifests (override the packaged bundles) ───────────────
#AI_LOG_ANALYZER_SAMPLES_DIR=/srv/netlog-ai/samples
#AI_LOG_ANALYZER_SITES_DIR=/srv/netlog-ai/sites

# ── Analysis tuning ──────────────────────────────────────────────────────────
# Collapse near-identical lines / enable the EVPN causal overlay by default.
#AI_LOG_ANALYZER_DEDUP=1
#AI_LOG_ANALYZER_EVPN_CAUSAL=1
# Ingest limits: longest line kept, and bytes read per file (0 = unlimited).
#AI_LOG_ANALYZER_MAX_LINE_BYTES=65536
#AI_LOG_ANALYZER_MAX_FILE_BYTES=0
# Flap detection: transitions within the window.
#AI_LOG_ANALYZER_FLAP_THRESHOLD=3
#AI_LOG_ANALYZER_FLAP_WINDOW_S=600

# ── Streaming triage (extras) ─────────────────────────────────────────────────
#AI_LOG_ANALYZER_TRIAGE_POLL_S=15
#AI_LOG_ANALYZER_TRIAGE_USE_LLM=false
# Comma list of registered source ids to include (empty = all).
#AI_LOG_ANALYZER_TRIAGE_SOURCES=

# ── LLM gateway (extras) ──────────────────────────────────────────────────────
# Same switch as ALLOW_CLOUD_FALLBACK above (ALLOW_CLOUD_FALLBACK wins when both are set).
# SECURITY: true lets sanitized text leave the site when a local provider fails.
#LLM_ALLOW_CLOUD_FALLBACK=false
# Overall wall-clock budget across retries and fallbacks, in seconds.
#LLM_TOTAL_TIMEOUT_S=180

# ── NetBox enrichment (optional) ──────────────────────────────────────────────
# Enabled only when BOTH are set. Use a read-only NetBox token.
#NETBOX_URL=https://netbox.example.com
#NETBOX_TOKEN=

# ── ITSM aliases ──────────────────────────────────────────────────────────────
# The web app and MCP server also accept JIRA_BASE_URL (alias of JIRA_URL) and
# SNOW_URL / SNOW_USER / SNOW_PASSWORD (aliases of the SERVICENOW_* names).
#JIRA_BASE_URL=https://example.atlassian.net
#SNOW_URL=https://example.service-now.com
#SNOW_USER=
#SNOW_PASSWORD=
# Bearer token alternative to user/password.
#SERVICENOW_TOKEN=

# ── FRR / device tooling ──────────────────────────────────────────────────────
#DCN_TOOL_URL=http://localhost:5757
# SECURITY: defaults to TRUE. When the tool API is unreachable the adapter runs
# `docker exec` on lab containers through the local Docker daemon (host-level
# privilege). Set to false on any shared or production host.
#DOCKER_EXEC_FALLBACK=false
# Read by generated runbook scripts (not by netlog-ai itself).
#NET_USER=admin
#NET_PASS=

# ── MCP server ────────────────────────────────────────────────────────────────
# stdio (default) | streamable-http. The HTTP transport exposes tools on the network.
#NETLOG_MCP_TRANSPORT=stdio
#NETLOG_MCP_TOKEN=
# Read-only by default; set true to let MCP tools create tickets / change external systems.
#NETLOG_MCP_ALLOW_WRITE=false

# ── Demo ──────────────────────────────────────────────────────────────────────
# UDP port for the built-in syslog listener used by `ai-log-analyzer demo`.
#NETLOG_DEMO_SYSLOG_PORT=5514
